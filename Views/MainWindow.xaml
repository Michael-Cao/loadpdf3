<Window x:Class="loadpdf3.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:loadpdf3.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Menu Bar -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Main Workspace Canvas -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Status Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP WINDOWS MENU BAR -->
        <Menu Grid.Row="0" Background="#FFFFFF">
            <MenuItem Header="_File">
                <MenuItem Header="_Open PDF..." Click="OpenPdf_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="ExitApp_Click">
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_Help" />
        </Menu>

        <Grid Grid.Row="1">
            <local:WorkspaceView Grid.Column="0"
                                 DataContext="{Binding Workspace, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

        <!-- Splitting Row 2 layout into: [Sidebar Panel | Grid Splitter | Main Workspace] -->
        <Grid Grid.Row="2">
            <local:StatusBarView Grid.Column="0"
                                 DataContext="{Binding StatusBar, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

    </Grid>
</Window>
